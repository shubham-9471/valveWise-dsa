# Force LF line endings for all text files
* text=auto eol=lf

# Explicitly binary files — no line-ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.tar  binary
*.gz   binary
*.exe  binary
*.dll  binary
*.so   binary
*.a    binary
*.lib  binary
*.o    binary

# Windows scripts stay CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
